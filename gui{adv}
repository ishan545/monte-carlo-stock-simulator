  75th: \u20b9{stats['percentile_75']:.2f}
  95th: \u20b9{stats['percentile_95']:.2f}
        """
        text_widget = tk.Text(self.results_frame, width=35, height=30, font=("Courier", 9),
                              bg=d['panel'], fg=d['fg'], insertbackground=d['fg'],
                              selectbackground=d['accent'])
        text_widget.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

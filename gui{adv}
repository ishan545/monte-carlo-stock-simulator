        'POWERGRID.NS', 'HCLTECH.NS', 'BAJAJFINSV.NS', 'TECHM.NS', 'NESTLEIND.NS',
        'TATAMOTORS.NS', 'TATASTEEL.NS', 'ADANIENT.NS', 'ADANIPORTS.NS', 'JSWSTEEL.NS',

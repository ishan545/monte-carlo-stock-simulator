    def __init__(self, root):
        self.root = root
        self.root.title("Monte Carlo Simulator — Nifty 50")
        self.root.geometry("1400x900")
        self.root.resizable(True, True)

        self.data_fetcher = DataFetcher(period="2y")
        self.current_simulation = None
        self.current_stock = None
        self.stock_stats = {}

        # ── Dark theme ───────────────────────────────────────────────────────
        self.root.configure(bg='#1e1e1e')
        style = ttk.Style()
        style.theme_use('clam')

        BG     = '#1e1e1e'
        PANEL  = '#2b2b2b'
        ACCENT = '#3c3f41'
        FG     = '#f0f0f0'
        GREEN  = '#4ec94e'
        RED    = '#f05050'
        BLUE   = '#6ab0f5'

        style.configure('.',                 background=BG,    foreground=FG)
        style.configure('TFrame',            background=BG)
        style.configure('TLabel',            background=BG,    foreground=FG)
        style.configure('TLabelframe',       background=PANEL, foreground=FG)
        style.configure('TLabelframe.Label', background=PANEL, foreground=BLUE)
        style.configure('TButton',           background=ACCENT, foreground=FG, padding=4)
        style.map('TButton',                 background=[('active', '#505050')])
        style.configure('TCombobox',         fieldbackground=ACCENT, background=ACCENT,
                        foreground=FG, selectbackground=ACCENT, selectforeground=FG)
        style.configure('TSpinbox',          fieldbackground=ACCENT, background=ACCENT, foreground=FG)
        style.configure('TEntry',            fieldbackground=ACCENT, foreground=FG, insertcolor=FG)
        style.configure('TSeparator',        background=ACCENT)
        style.configure('TScrollbar',        background=ACCENT, troughcolor=BG)

        self._dark = dict(bg=BG, panel=PANEL, accent=ACCENT,
                          fg=FG, green=GREEN, red=RED, blue=BLUE)
        # ─────────────────────────────────────────────────────────────────────

        self.create_widgets()
        self.load_stock_statistics()

    # ── Dark helpers ──────────────────────────────────────────────────────────

    def _dark_fig(self, figsize=(10, 8)):
        return Figure(figsize=figsize, dpi=100, facecolor=self._dark['panel'])

    def _style_ax(self, ax):
        d = self._dark
        ax.set_facecolor(d['bg'])
        ax.tick_params(colors=d['fg'])
        ax.xaxis.label.set_color(d['fg'])
        ax.yaxis.label.set_color(d['fg'])
        ax.title.set_color(d['blue'])
        for spine in ax.spines.values():
            spine.set_edgecolor(d['accent'])
        return ax

    # ── Widgets ───────────────────────────────────────────────────────────────

    def create_widgets(self):
        control_frame = ttk.Frame(self.root)
        control_frame.pack(side=tk.TOP, fill=tk.X, padx=10, pady=10)

        ttk.Label(control_frame, text="Stock:").pack(side=tk.LEFT, padx=5)
        self.stock_var = tk.StringVar(value="RELIANCE.NS")
        stock_combo = ttk.Combobox(control_frame, textvariable=self.stock_var,
                                   values=self.STOCKS, state="readonly", width=14)
